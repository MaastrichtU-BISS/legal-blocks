# Runtime state, created on first run.
/data/

# Editor and OS noise.
/.vscode/
.DS_Store

/web/node_modules/

# web/dist is deliberately NOT ignored: the Go binary embeds it, so committing
# it is what lets someone clone this and run `go run ./cmd/legal-blocks compose`
# with no Node installed at all. Rebuild it with `cd web && npm run build`.

# Cross-compiled platform binaries. Build artifacts, ~36 MB; regenerate with
# ./script/build-platforms.sh.
/binaries/

# Exported platforms and local builds.
*.zip
/legal-blocks

# Rendered documentation. The markdown is the source; regenerate with
# ./script/build-docs.sh. Tracking the PDF would put a binary diff in every
# commit that touches a sentence.
/docs/*.pdf
