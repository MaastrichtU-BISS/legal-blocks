{
  "name": "legal-blocks",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "dev:platform": "pnpm --filter @legal-blocks/platform dev",
    "dev:composer": "pnpm --filter @legal-blocks/composer dev",
    "build": "pnpm --filter @legal-blocks/platform build && pnpm --filter @legal-blocks/composer build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build --force"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
