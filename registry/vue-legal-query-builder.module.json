{
  "id": "vue-legal-query-builder",
  "name": "Search documents",
  "description": "Search Rechtspraak and ECHR case law. Uses the hosted Case Law Explorer service, which needs an access token you create yourself — the platform keeps it on the server and never shows it to the people using it.",
  "icon": "search",
  "version": "2.2.0",
  "kind": "source",
  "runtime": "web",
  "entry": {
    "package": "vue-legal-query-builder",
    "component": "LegalDocsForm",
    "style": "vue-legal-query-builder/style.css"
  },
  "host": "DocumentSearch",
  "services": [
    "legal-docs"
  ],
  "worksIn": [
    "pipeline",
    "workspace"
  ],
  "outputs": [
    {
      "name": "documents",
      "type": "document-set@1"
    }
  ],
  "config": [
    {
      "key": "api_token",
      "label": "Case Law Explorer access token",
      "type": "secret",
      "default": "",
      "required": true,
      "link": "https://api.caselawexplorer.tech/login.html?next=/account.html",
      "linkText": "Create a token"
    },
    {
      "key": "mode",
      "label": "Form",
      "type": "select",
      "options": [
        "guided",
        "free-form"
      ],
      "optionLabels": {
        "guided": "Guided form",
        "free-form": "Free form"
      },
      "default": "guided",
      "help": "Guided walks people through a few short steps. Free form puts every filter on one page, for someone who already knows what they are looking for."
    },
    {
      "key": "guided_source",
      "label": "Guided structure",
      "type": "select",
      "options": [
        "template",
        "upload"
      ],
      "optionLabels": {
        "template": "Use a template",
        "upload": "Upload a JSON file"
      },
      "default": "template",
      "showWhen": {
        "mode": "guided"
      },
      "help": "The goals, steps and blocks the guided form walks through."
    },
    {
      "key": "guided_template",
      "label": "Template",
      "type": "select",
      "options": [
        "caselaw-search"
      ],
      "optionLabels": {
        "caselaw-search": "Case law search"
      },
      "default": "caselaw-search",
      "showWhen": {
        "guided_source": "template"
      },
      "help": "Offers similarity, authority and traditional keyword search."
    },
    {
      "key": "guided_structure",
      "label": "Structure file",
      "type": "json",
      "default": "",
      "showWhen": {
        "guided_source": "upload"
      },
      "help": "A .json file with the goals, steps and blocks to walk through. Leave it empty and the form falls back to the default template.",
      "link": "https://github.com/MaastrichtU-BISS/vue-legal-query-builder#guidedform",
      "linkText": "See what a structure looks like"
    },
    {
      "key": "title",
      "label": "Form title",
      "type": "text",
      "default": "Find documents"
    }
  ],
  "upstream": {
    "service": "legal-docs",
    "baseUrlKey": "api_base_url",
    "baseUrl": "https://api.caselawexplorer.tech/api",
    "tokenKey": "api_token",
    "envVar": "CITATIONS_API_KEY"
  }
}
