{
  "id": "vue-iaa-metrics",
  "name": "Agreement metrics",
  "description": "Browse annotations and compute inter-annotator agreement. The match criterion and coverage granularity are chosen by whoever computes them, not fixed when the export is built.",
  "version": "1.0.2",
  "kind": "ui",
  "runtime": "web",
  "entry": {
    "package": "vue-iaa-metrics",
    "component": "MetricsPage",
    "style": "vue-iaa-metrics/style.css"
  },
  "host": "MetricsSource",
  "worksIn": [
    "pipeline",
    "workspace"
  ],
  "requiredRole": "admin",
  "services": [
    "lawnotation-iaa"
  ],
  "inputs": [
    {
      "name": "task",
      "type": "annotated-task@1",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "task",
      "type": "annotated-task@1"
    }
  ]
}
